<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>xyz.fallenmc</groupId>
    <artifactId>ClassShops</artifactId>
    <version>1.0</version>
    <dependencies>
        <dependency>
            <groupId>com.github.CobbleSword.NachoSpigot</groupId>
            <artifactId>api</artifactId>
            <version>57e8295c68</version>
        </dependency>
        <dependency>
            <groupId>net.jitse</groupId>
            <artifactId>npclib-api</artifactId>
            <version>2.11.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>xyz.fallenmc</groupId>
            <artifactId>MainPlugin</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${user.home}/Desktop/Server/plugins/MainPlugin.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>xyz.fallenmc</groupId>
            <artifactId>FallenItems</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${user.home}/Desktop/Server/plugins/FallenItems.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>xyz.fallenmc</groupId>
            <artifactId>Databank</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${user.home}/Desktop/Server/plugins/DataBank.jar</systemPath>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <repository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/content/groups/public/</url>
        </repository>
    </repositories>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <org-yaml.snakeyaml.version>2.0</org-yaml.snakeyaml.version>
        <com-google-code-gson.gson.version>2.8.9</com-google-code-gson.gson.version>
        <junit.junit.version>4.13.1</junit.junit.version>
        <com-google-guava.guava.version>24.1.1-android</com-google-guava.guava.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>${org-yaml.snakeyaml.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${com-google-code-gson.gson.version}</version>
            </dependency>
            <dependency>
                <groupId>junit</groupId>
                <artifactId>junit</artifactId>
                <version>${junit.junit.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${com-google-guava.guava.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
</project>